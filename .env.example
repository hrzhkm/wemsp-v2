# Database URL for PostgreSQL
# For Docker: use host.docker.internal instead of localhost
DATABASE_URL=

# Better auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# Bootstrap admin account created by `pnpm db:seed` (via better-auth signup).
# The account is created with a usable password, marked email-verified, and promoted to ADMIN.
# Both are REQUIRED for db:seed (no fallback). Set a strong ADMIN_PASSWORD; never reuse the example.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Admin

# API Base URL (for client-side requests)
# For Docker: use the exposed port (e.g., http://localhost:5050)
VITE_API_BASE_URL=http://localhost:3000

# Admin app origin for CORS
ADMIN_ORIGIN=http://localhost:3001

# Google OAuth - https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_APP_PASSWORD=
EMAIL_ADMIN=
EMAIL_FROM=

# Cloudflare R2 private asset-document storage
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 32-byte key encoded as base64 or 64-character hex. Back this up securely.
DOCUMENT_RECOVERY_KEY=

# IPFS / Pinata encrypted agreement metadata
PINATA_GATEWAY=
PINATA_JWT=
# 32-byte server-managed key encoded as base64 or 64-character hex.
# Generate with: openssl rand -base64 32
IPFS_ENCRYPTION_KEY=

# OpenRouter (LangChain ChatOpenAI-compatible endpoint)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional ranking headers for OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=WEMSP

# Contract
PRIVATE_KEY=
RPC_URL=
RPC_URL_FALLBACK=
CONTRACT_ADDRESS=
